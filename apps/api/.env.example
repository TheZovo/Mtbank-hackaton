MTB_APP_NAME=MTB Galaxy API
MTB_ENV=development
MTB_API_PREFIX=/v1
MTB_CORS_ORIGINS=http://localhost:8081
MTB_DATABASE_URL=postgresql+asyncpg://mtb:mtb@localhost:5432/mtb_galaxy
MTB_REDIS_URL=redis://localhost:6379/0
MTB_JWT_SECRET=change-me
MTB_ACCESS_TOKEN_TTL_MINUTES=30
MTB_REFRESH_TOKEN_TTL_DAYS=30
MTB_OTP_TTL_SECONDS=300
MTB_OTP_MAX_ATTEMPTS=5
MTB_OTP_DEV_BYPASS=true
MTB_AUTO_CREATE_SCHEMA=false
MTB_SEED_DEFAULTS=false
